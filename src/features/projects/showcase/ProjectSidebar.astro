---
import FolderIcon from "@components/icons/FolderIcon.astro";
import SearchIcon from "@components/icons/SearchIcon.astro";
import { formatDate } from "@utils/date";
import type { ProjectShowcaseItem } from "../types";

interface Props {
  items: ProjectShowcaseItem[];
  activeId: string;
}

const { items, activeId } = Astro.props;

// 카테고리별 그룹화
const grouped = items.reduce<Record<string, ProjectShowcaseItem[]>>((acc, item) => {
  if (!acc[item.category]) acc[item.category] = [];
  acc[item.category].push(item);
  return acc;
}, {});

const categories = Object.keys(grouped).sort();
---

<aside
  aria-label="프로젝트 카탈로그 목록"
  class="h-full flex flex-col rounded-3xl bg-surface-container border border-glass-border shadow-neumorphism overflow-hidden select-none">
  <!-- 카탈로그 헤더 및 검색창 -->
  <div class="p-4 border-b border-glass-border space-y-3 shrink-0">
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2 min-w-0">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-brand truncate">
          프로젝트 카탈로그
        </span>
        <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-brand-muted text-brand font-semibold shrink-0">
          {items.length}
        </span>
      </div>
      <span class="text-xs font-mono text-text-muted shrink-0">Showcase</span>
    </div>

    <!-- 실시간 필터 검색 인풋 -->
    <div class="relative">
      <SearchIcon class="w-4 h-4 text-text-muted absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" />
      <input
        type="search"
        data-project-search
        placeholder="프로젝트명, 도메인, 기술 스택 검색..."
        aria-label="프로젝트 카탈로그 실시간 검색"
        class="w-full min-h-12 pl-10 pr-4 rounded-2xl bg-glass-bg border border-glass-border text-xs medium:text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-all"
      />
    </div>
  </div>

  <!-- 카테고리별 카드형 프로젝트 목록 -->
  <div class="flex-1 overflow-y-auto p-3 space-y-3">
    {categories.map((category) => {
      const catItems = grouped[category];
      return (
        <details open data-project-group class="group/folder mb-2">
          <summary class="min-h-12 flex items-center justify-between px-3 py-2 rounded-2xl hover:bg-glass-bg cursor-pointer text-xs font-bold text-text-muted hover:text-text-primary uppercase tracking-wider transition-colors list-none">
            <div class="flex items-center gap-2 min-w-0">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-3.5 h-3.5 text-text-muted group-open/folder:rotate-90 transition-transform shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
              <FolderIcon class="w-4 h-4 text-brand shrink-0" />
              <span class="truncate">{category}</span>
            </div>
            <span data-group-count class="text-xs font-mono text-text-muted font-normal ml-2">
              {catItems.length}
            </span>
          </summary>

          <ul class="mt-1.5 space-y-2">
            {catItems.map((item) => {
              const searchCorpus = [
                item.title,
                item.category,
                item.description ?? "",
                ...(item.sub_category ?? []),
                ...(item.tags ?? []),
              ]
                .join(" ")
                .toLowerCase();
              const visibleTags = (item.tags ?? []).slice(0, 3);
              const extraTagCount = Math.max((item.tags?.length ?? 0) - visibleTags.length, 0);

              return (
                <li data-project-item data-search-text={searchCorpus}>
                  <button
                    type="button"
                    data-project-btn={item.id}
                    aria-current={item.id === activeId ? "true" : "false"}
                    class="group/card w-full min-h-12 p-3 rounded-2xl flex flex-col gap-1.5 text-left transition-all duration-150 cursor-pointer border border-glass-border bg-glass-bg/60 text-text-muted aria-[current=false]:hover:text-text-primary aria-[current=false]:hover:bg-glass-bg aria-[current=false]:hover:border-brand/30 aria-[current=true]:bg-brand-soft aria-[current=true]:text-text-primary aria-[current=true]:border-brand/45 aria-[current=true]:shadow-xs">
                    <div class="flex items-start justify-between gap-2 w-full">
                      <span class="text-xs medium:text-sm font-bold leading-snug line-clamp-2 text-text-primary group-aria-[current=true]/card:text-brand transition-colors">
                        {item.title}
                      </span>
                      {item.architecture && (
                        <span
                          title="아키텍처 토폴로지 포함"
                          class="shrink-0 text-xs font-mono font-bold px-2 py-0.5 rounded-lg bg-brand-muted text-brand">
                          Arch
                        </span>
                      )}
                    </div>

                    <div class="flex flex-wrap items-center gap-1.5 text-xs font-mono text-text-muted">
                      <time datetime={item.pubDate.toISOString()}>{formatDate(item.pubDate)}</time>
                      {item.sub_category && item.sub_category.length > 0 && (
                        <>
                          <span>•</span>
                          <span class="truncate">{item.sub_category.join(" · ")}</span>
                        </>
                      )}
                    </div>

                    {visibleTags.length > 0 && (
                      <div class="flex flex-wrap gap-1 pt-0.5">
                        {visibleTags.map((tag) => (
                          <span class="text-xs font-mono px-2 py-0.5 rounded-md bg-surface-container border border-glass-border text-text-muted">
                            #{tag}
                          </span>
                        ))}
                        {extraTagCount > 0 && (
                          <span class="text-xs font-mono px-1.5 py-0.5 text-text-muted">
                            +{extraTagCount}
                          </span>
                        )}
                      </div>
                    )}
                  </button>
                </li>
              );
            })}
          </ul>
        </details>
      );
    })}
    <p data-project-empty class="hidden p-6 text-center text-xs text-text-muted">
      검색 결과가 없습니다.
    </p>
  </div>
</aside>
