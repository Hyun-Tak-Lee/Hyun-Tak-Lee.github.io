---
import type { ArchitectureData } from "../../content.config";
import { buildArchitectureGraphModel } from "./architecture";
import ArchitectureHeader from "./ArchitectureHeader.astro";
import ArchitectureCanvas from "./ArchitectureCanvas.astro";
import ArchitectureInspector from "./ArchitectureInspector.astro";

interface Props {
  architecture: ArchitectureData;
  instanceId?: string;
}

const { architecture, instanceId = "default" } = Astro.props;
const uid = instanceId.replace(/[^a-zA-Z0-9_-]/g, "-");

const { summary, groups, nodes, edges, groupedNodes, enrichedNodes, defaultNodeId } =
  buildArchitectureGraphModel(architecture);
---

{nodes.length > 0 && (
  <div data-arch-shell={uid}>
    <div data-arch-inline-host>
      <section
        data-arch-root={uid}
        aria-label="시스템 아키텍처 인터랙티브 그래프"
        class="rounded-3xl bg-surface-container border border-glass-border shadow-neumorphism p-5 medium:p-6 space-y-5">
        <ArchitectureHeader
          summary={summary}
          groupCount={groups.length}
          nodeCount={nodes.length}
          edgeCount={edges.length}
        />

        <ArchitectureCanvas
          uid={uid}
          groupedNodes={groupedNodes}
          edges={edges}
          defaultNodeId={defaultNodeId}
        />

        <ArchitectureInspector enrichedNodes={enrichedNodes} defaultNodeId={defaultNodeId} />
      </section>
    </div>

    <dialog
      data-arch-modal
      aria-label="시스템 아키텍처 토폴로지 전체 화면"
      class="max-w-none max-h-[90dvh] w-[95vw] m-auto p-0 bg-background border-0 text-text-primary overflow-y-auto rounded-3xl shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-xs"></dialog>
  </div>
)}

<script is:inline>
  (() => {
    const roots = document.querySelectorAll("[data-arch-root]");
    roots.forEach((root) => {
      if (root.dataset.archInitialized === "true") return;
      root.dataset.archInitialized = "true";

      const uid = root.dataset.archRoot;
      const canvas = root.querySelector("[data-arch-canvas]");
      const svg = root.querySelector("[data-arch-svg]");
      const nodeButtons = root.querySelectorAll("[data-arch-node]");
      const edgePaths = root.querySelectorAll("[data-arch-edge]");
      const inspectors = root.querySelectorAll("[data-arch-inspector]");
      const jumpButtons = root.querySelectorAll("[data-arch-jump]");
      const resetButton = root.querySelector("[data-arch-reset]");
      const modeLabel = root.querySelector("[data-arch-mode-label]");
      const shell = root.closest("[data-arch-shell]");
      const inlineHost = shell?.querySelector("[data-arch-inline-host]");
      const modal = shell?.querySelector("[data-arch-modal]");
      const modalToggleButton = root.querySelector("[data-arch-modal-toggle]");

      if (!canvas || nodeButtons.length === 0) return;

      let selectedNodeId = nodeButtons[0].dataset.archNode;
      let isOverviewMode = false;

      // 두 노드 DOM 위치 기반 부드러운 곡선(Bezier) 경로 계산
      const computeEdgePath = (fromEl, toEl, canvasRect) => {
        const r1 = fromEl.getBoundingClientRect();
        const r2 = toEl.getBoundingClientRect();

        const x1Center = r1.left - canvasRect.left + r1.width / 2;
        const y1Center = r1.top - canvasRect.top + r1.height / 2;
        const x2Center = r2.left - canvasRect.left + r2.width / 2;
        const y2Center = r2.top - canvasRect.top + r2.height / 2;

        const dx = x2Center - x1Center;
        const dy = y2Center - y1Center;

        // 좌우 다른 그룹 컬럼 간 연결
        if (Math.abs(dx) > r1.width * 0.65) {
          const startX = dx > 0 ? r1.right - canvasRect.left : r1.left - canvasRect.left;
          const endX = dx > 0 ? r2.left - canvasRect.left : r2.right - canvasRect.left;
          const startY = y1Center;
          const endY = y2Center;
          const ctrlOffset = Math.max(Math.abs(endX - startX) * 0.45, 36);
          const c1x = dx > 0 ? startX + ctrlOffset : startX - ctrlOffset;
          const c2x = dx > 0 ? endX - ctrlOffset : endX + ctrlOffset;
          return `M ${startX} ${startY} C ${c1x} ${startY}, ${c2x} ${endY}, ${endX} ${endY}`;
        }

        // 같은 컬럼 내에서 인접한 상하 노드 연결
        if (Math.abs(dy) <= (r1.height + r2.height) * 1.15) {
          const startY = dy > 0 ? r1.bottom - canvasRect.top : r1.top - canvasRect.top;
          const endY = dy > 0 ? r2.top - canvasRect.top : r2.bottom - canvasRect.top;
          const ctrlY = Math.max(Math.abs(endY - startY) * 0.45, 20);
          const c1y = dy > 0 ? startY + ctrlY : startY - ctrlY;
          const c2y = dy > 0 ? endY - ctrlY : endY + ctrlY;
          return `M ${x1Center} ${startY} C ${x1Center} ${c1y}, ${x2Center} ${c2y}, ${x2Center} ${endY}`;
        }

        // 같은 컬럼 내에서 중간 노드를 건너뛰는 상하 연결 (우측 외곽 곡선 우회)
        const startX = r1.right - canvasRect.left;
        const endX = r2.right - canvasRect.left;
        const arcOffset = 28;
        const maxRight = Math.max(startX, endX) + arcOffset;
        return `M ${startX} ${y1Center} C ${maxRight} ${y1Center}, ${maxRight} ${y2Center}, ${endX} ${y2Center}`;
      };

      const drawEdges = () => {
        if (!svg || window.getComputedStyle(svg).display === "none") return;
        const canvasRect = canvas.getBoundingClientRect();
        if (canvasRect.width === 0 || canvasRect.height === 0) return;

        edgePaths.forEach((path) => {
          const fromId = path.dataset.from;
          const toId = path.dataset.to;
          const fromEl = root.querySelector(`[data-arch-node="${fromId}"]`);
          const toEl = root.querySelector(`[data-arch-node="${toId}"]`);
          if (!fromEl || !toEl) return;

          const d = computeEdgePath(fromEl, toEl, canvasRect);
          path.setAttribute("d", d);
        });
      };

      const applyVisualState = () => {
        const inboundNodeIds = new Set();
        const outboundNodeIds = new Set();

        edgePaths.forEach((path) => {
          const fromId = path.dataset.from;
          const toId = path.dataset.to;
          const isBi = path.dataset.bidirectional === "true";

          if (isOverviewMode || !selectedNodeId) {
            path.setAttribute("stroke", "var(--color-brand)");
            path.setAttribute("stroke-opacity", "0.45");
            path.setAttribute("stroke-width", "2");
            path.setAttribute("stroke-dasharray", "4 4");
            path.setAttribute("marker-end", `url(#arch-arrow-out-${uid})`);
            if (isBi) path.setAttribute("marker-start", `url(#arch-arrow-out-${uid})`);
            return;
          }

          const isOutbound = fromId === selectedNodeId || (isBi && toId === selectedNodeId);
          const isInbound = toId === selectedNodeId || (isBi && fromId === selectedNodeId);

          if (fromId === selectedNodeId) outboundNodeIds.add(toId);
          if (toId === selectedNodeId) inboundNodeIds.add(fromId);
          if (isBi && fromId === selectedNodeId) inboundNodeIds.add(toId);
          if (isBi && toId === selectedNodeId) outboundNodeIds.add(fromId);

          if (isOutbound) {
            path.setAttribute("stroke", "var(--color-brand)");
            path.setAttribute("stroke-opacity", "0.95");
            path.setAttribute("stroke-width", "2.5");
            path.removeAttribute("stroke-dasharray");
            path.setAttribute("marker-end", `url(#arch-arrow-out-${uid})`);
            if (isBi) path.setAttribute("marker-start", `url(#arch-arrow-out-${uid})`);
          } else if (isInbound) {
            path.setAttribute("stroke", "var(--color-accent)");
            path.setAttribute("stroke-opacity", "0.95");
            path.setAttribute("stroke-width", "2.5");
            path.removeAttribute("stroke-dasharray");
            path.setAttribute("marker-end", `url(#arch-arrow-in-${uid})`);
            if (isBi) path.setAttribute("marker-start", `url(#arch-arrow-in-${uid})`);
          } else {
            path.setAttribute("stroke", "var(--color-text-muted)");
            path.setAttribute("stroke-opacity", "0.15");
            path.setAttribute("stroke-width", "1.5");
            path.setAttribute("stroke-dasharray", "4 4");
            path.setAttribute("marker-end", `url(#arch-arrow-muted-${uid})`);
            if (isBi) path.setAttribute("marker-start", `url(#arch-arrow-muted-${uid})`);
          }
        });

        nodeButtons.forEach((btn) => {
          const nodeId = btn.dataset.archNode;
          const badge = root.querySelector(`[data-arch-node-badge="${nodeId}"]`);
          const isSelected = !isOverviewMode && nodeId === selectedNodeId;
          const isIn = !isOverviewMode && inboundNodeIds.has(nodeId);
          const isOut = !isOverviewMode && outboundNodeIds.has(nodeId);

          btn.setAttribute("aria-pressed", isSelected ? "true" : "false");
          btn.classList.remove(
            "border-brand",
            "bg-brand-soft",
            "ring-2",
            "ring-brand/40",
            "border-accent",
            "opacity-45",
          );

          if (badge) {
            badge.className = "hidden text-xs font-mono font-bold px-2 py-0.5 rounded-lg shrink-0";
            badge.textContent = "";
          }

          if (isOverviewMode) return;

          if (isSelected) {
            btn.classList.add("border-brand", "bg-brand-soft", "ring-2", "ring-brand/40");
            if (badge) {
              badge.classList.remove("hidden");
              badge.classList.add("bg-brand", "text-on-brand");
              badge.textContent = "선택됨";
            }
          } else if (isIn && isOut) {
            btn.classList.add("border-brand");
            if (badge) {
              badge.classList.remove("hidden");
              badge.classList.add("bg-brand-muted", "text-brand");
              badge.textContent = "양방향 (In/Out)";
            }
          } else if (isIn) {
            btn.classList.add("border-accent");
            if (badge) {
              badge.classList.remove("hidden");
              badge.classList.add("bg-glass-bg", "border", "border-accent", "text-accent");
              badge.textContent = "입력 (Upstream)";
            }
          } else if (isOut) {
            btn.classList.add("border-brand");
            if (badge) {
              badge.classList.remove("hidden");
              badge.classList.add("bg-brand-muted", "text-brand");
              badge.textContent = "출력 (Downstream)";
            }
          } else {
            btn.classList.add("opacity-45");
          }
        });

        inspectors.forEach((panel) => {
          panel.classList.toggle("hidden", panel.dataset.archInspector !== selectedNodeId);
        });

        if (resetButton) {
          resetButton.setAttribute("aria-pressed", isOverviewMode ? "true" : "false");
          resetButton.classList.toggle("text-brand", isOverviewMode);
          resetButton.classList.toggle("border-brand", isOverviewMode);
        }

        if (modeLabel) {
          modeLabel.textContent = isOverviewMode ? "전체 연결 모드" : "포커스 모드";
        }
      };

      const selectNode = (nodeId) => {
        selectedNodeId = nodeId;
        isOverviewMode = false;
        applyVisualState();
        drawEdges();
      };

      nodeButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const clickedId = btn.dataset.archNode;
          if (!isOverviewMode && selectedNodeId === clickedId) {
            isOverviewMode = true;
            applyVisualState();
          } else {
            selectNode(clickedId);
          }
        });
      });

      jumpButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetId = btn.dataset.archJump;
          if (targetId) selectNode(targetId);
        });
      });

      if (resetButton) {
        resetButton.addEventListener("click", () => {
          isOverviewMode = !isOverviewMode;
          applyVisualState();
        });
      }

      if (modal && inlineHost && modalToggleButton) {
        const syncModalButton = (isOpen) => {
          modalToggleButton.setAttribute("aria-pressed", isOpen ? "true" : "false");
          const label = isOpen ? "전체 화면 닫기" : "아키텍처 그래프 전체 화면으로 확대";
          modalToggleButton.setAttribute("aria-label", label);
          modalToggleButton.setAttribute("title", label);
          modalToggleButton.classList.toggle("text-brand", isOpen);
          modalToggleButton.classList.toggle("border-brand", isOpen);
          modalToggleButton
            .querySelector("[data-arch-expand-icon]")
            ?.classList.toggle("hidden", isOpen);
          modalToggleButton
            .querySelector("[data-arch-expand-icon]")
            ?.classList.toggle("inline-flex", !isOpen);
          modalToggleButton
            .querySelector("[data-arch-collapse-icon]")
            ?.classList.toggle("hidden", !isOpen);
          modalToggleButton
            .querySelector("[data-arch-collapse-icon]")
            ?.classList.toggle("inline-flex", isOpen);
        };

        modalToggleButton.addEventListener("click", () => {
          if (modal.open) {
            modal.close();
          } else {
            modal.appendChild(root);
            modal.showModal();
            syncModalButton(true);
            requestAnimationFrame(drawEdges);
          }
        });

        modal.addEventListener("close", () => {
          if (root.parentElement !== inlineHost) {
            inlineHost.appendChild(root);
          }
          syncModalButton(false);
          requestAnimationFrame(drawEdges);
        });

        modal.addEventListener("click", (e) => {
          if (e.target === modal) modal.close();
        });
      }

      const ro = new ResizeObserver(() => {
        drawEdges();
      });
      ro.observe(canvas);
      window.addEventListener("resize", drawEdges);

      applyVisualState();
      requestAnimationFrame(drawEdges);
    });
  })();
</script>
