---
import CollapseIcon from "@components/icons/CollapseIcon.astro";
import ArchitectureGraph from "../architecture/ArchitectureGraph.astro";
import type { ArchitectureData } from "@/content.config";
import type { ProjectHeading } from "../types";
import { formatDate } from "@utils/date";

interface Props {
  id: string;
  title: string;
  category: string;
  sub_category?: string[];
  pubDate: Date;
  description?: string;
  tags?: string[];
  image?: {
    url: string;
    alt: string;
  };
  architecture?: ArchitectureData;
  headings: ProjectHeading[];
  Content: any;
  isStandalone?: boolean;
  archSectionId: string;
  archInstanceId: string;
}

const {
  id,
  title,
  category,
  sub_category,
  pubDate,
  description,
  tags,
  image,
  architecture,
  headings,
  Content,
  isStandalone = false,
  archSectionId,
  archInstanceId,
} = Astro.props;

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasQuickNav = Boolean(architecture) || tocHeadings.length > 0;
const hasSpecsBar = Boolean(architecture) || (tags && tags.length > 0);
---

<header class="pb-6 border-b border-glass-border space-y-5">
  <div class="flex items-start justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
      <span class="px-2.5 py-1 rounded-full bg-brand-muted border border-brand/25 text-brand font-bold uppercase tracking-wider">
        {category}
      </span>
      {sub_category?.map((sub) => (
        <span class="px-2.5 py-1 rounded-full bg-glass-bg border border-glass-border text-text-muted font-medium">
          {sub}
        </span>
      ))}
      <time
        datetime={pubDate.toISOString()}
        class="px-2.5 py-1 rounded-full bg-glass-bg border border-glass-border text-text-muted">
        {formatDate(pubDate)}
      </time>
    </div>

    {isStandalone && (
      <a
        href={`/projects?file=${id}`}
        aria-label={`${title} 쇼케이스 화면으로 축소`}
        title="쇼케이스 화면으로 축소"
        class="shrink-0 min-h-12 min-w-12 -mt-2 -mr-2 inline-flex items-center justify-center rounded-full text-text-muted hover:text-brand hover:bg-glass-bg-hover transition-colors">
        <CollapseIcon class="w-5 h-5" />
      </a>
    )}
  </div>

  <div class="space-y-3">
    {isStandalone ? (
      <h1 class="text-2xl medium:text-4xl expanded:text-5xl font-extrabold tracking-tight leading-tight">
        {title}
      </h1>
    ) : (
      <h2 class="text-2xl medium:text-3xl expanded:text-4xl font-extrabold tracking-tight leading-tight">
        {title}
      </h2>
    )}

    {description && (
      <p class="text-sm medium:text-base expanded:text-lg text-text-muted leading-relaxed max-w-4xl">
        {description}
      </p>
    )}
  </div>

  {hasSpecsBar && (
    <div class="rounded-2xl bg-glass-bg border border-glass-border p-4 flex flex-col expanded:flex-row expanded:items-center justify-between gap-3">
      {architecture && (
        <div class="flex flex-wrap items-center gap-2 text-xs font-mono shrink-0">
          <span class="px-2.5 py-1 rounded-xl bg-brand-soft border border-brand/25 text-brand font-bold">
            아키텍처 토폴로지
          </span>
          <span class="text-text-muted">
            그룹 <strong class="text-text-primary">{architecture.groups.length}</strong> · 파츠{" "}
            <strong class="text-text-primary">{architecture.nodes.length}</strong> · 연결{" "}
            <strong class="text-text-primary">{(architecture.edges ?? []).length}</strong>
          </span>
        </div>
      )}

      {tags && tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-1.5">
          {tags.map((tag) => (
            <span class="px-2.5 py-1 rounded-xl bg-surface-container border border-glass-border text-xs font-mono font-medium text-text-primary">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </div>
  )}
</header>

{image && (
  <div class="rounded-2xl medium:rounded-3xl overflow-hidden border border-glass-border shadow-neumorphism">
    <img src={image.url} alt={image.alt} class="w-full h-auto object-cover" />
  </div>
)}

{hasQuickNav && (
  <nav
    aria-label="프로젝트 섹션 빠른 탐색"
    class="rounded-2xl bg-glass-bg border border-glass-border p-3.5 space-y-2.5">
    <div class="text-xs font-mono font-bold uppercase tracking-wider text-text-muted px-1">
      섹션 빠른 탐색
    </div>
    <div class="flex flex-wrap gap-2">
      {architecture && (
        <a
          href={`#${archSectionId}`}
          class="min-h-12 px-4 rounded-xl bg-brand-soft border border-brand/30 text-brand font-bold text-xs inline-flex items-center hover:bg-brand-muted transition-colors">
          시스템 아키텍처
        </a>
      )}
      {tocHeadings.map((heading) => (
        <a
          href={`#${heading.slug}`}
          data-project-toc-target={heading.slug}
          class:list={[
            "min-h-12 max-w-full px-3.5 rounded-xl bg-surface-container border border-glass-border text-xs inline-flex items-center hover:border-brand/50 hover:text-brand transition-colors",
            heading.depth === 3 ? "text-text-muted" : "font-semibold text-text-primary",
          ]}>
          {heading.depth === 3 ? `└ ${heading.text}` : heading.text}
        </a>
      ))}
    </div>
  </nav>
)}

{architecture && (
  <section id={archSectionId} class="scroll-mt-[calc(var(--spacing-header)+1rem)]">
    <ArchitectureGraph architecture={architecture} instanceId={archInstanceId} />
  </section>
)}

<div class="prose prose-brand prose-base medium:prose-lg max-w-none prose-headings:font-bold prose-headings:scroll-mt-[calc(var(--spacing-header)+1rem)] prose-a:text-brand hover:prose-a:underline prose-img:rounded-2xl medium:prose-img:rounded-3xl prose-pre:overflow-x-auto text-text-primary">
  <Content />
</div>
