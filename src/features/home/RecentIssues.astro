---
import { formatDate } from "@utils/date";
import type { IssueCardItem, IssueFilter } from "./issues";

interface Props {
  countsByFilter: Record<IssueFilter, number>;
  displayedIssues: IssueCardItem[];
}

const { countsByFilter, displayedIssues } = Astro.props;
---

<!-- Recent Issues Section with M3 Fixed Tabs (3 items = Equal 3-column Fixed Tabs on Mobile) -->
<section>
  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
    <h2 class="text-xl medium:text-2xl font-bold flex items-center gap-3">
      <span class="w-2 h-7 bg-brand rounded-full shrink-0"></span>
      최근 이슈
    </h2>
  </div>

  <!-- Sticky M3 Fixed Tabs (3 Equal Width Tabs on Compact, Inline Tabs on Medium+) -->
  <div class="sticky top-header z-30 -mx-4 px-4 medium:mx-0 medium:px-0 bg-surface-nav/95 medium:bg-transparent backdrop-blur-xl medium:backdrop-blur-none border-b border-glass-border mb-6">
    <div
      role="tablist"
      aria-label="최근 이슈 분류 필터"
      class="grid grid-cols-3 medium:inline-flex medium:w-auto w-full">
      <button
        type="button"
        role="tab"
        aria-selected="true"
        data-issue-filter="all"
        class="issue-tab relative min-h-12 px-2 medium:px-4 whitespace-nowrap inline-flex items-center justify-center gap-2 text-sm font-bold text-brand transition-colors cursor-pointer">
        <span>전체</span>
        <span class="text-xs font-mono opacity-80">({countsByFilter.all})</span>
        <span class="tab-indicator absolute bottom-0 left-3 right-3 h-[3px] rounded-t-full bg-brand"></span>
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-issue-filter="projects"
        class="issue-tab relative min-h-12 px-2 medium:px-4 whitespace-nowrap inline-flex items-center justify-center gap-2 text-sm font-medium text-text-muted hover:text-text-primary transition-colors cursor-pointer">
        <span>프로젝트</span>
        <span class="text-xs font-mono opacity-80">({countsByFilter.projects})</span>
        <span class="tab-indicator absolute bottom-0 left-3 right-3 h-[3px] rounded-t-full bg-brand hidden"></span>
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-issue-filter="tech"
        class="issue-tab relative min-h-12 px-2 medium:px-4 whitespace-nowrap inline-flex items-center justify-center gap-2 text-sm font-medium text-text-muted hover:text-text-primary transition-colors cursor-pointer">
        <span>기술</span>
        <span class="text-xs font-mono opacity-80">({countsByFilter.tech})</span>
        <span class="tab-indicator absolute bottom-0 left-3 right-3 h-[3px] rounded-t-full bg-brand hidden"></span>
      </button>
    </div>
  </div>

  <div
    id="issue-empty"
    class:list={[
      "text-center py-12 px-4 rounded-3xl bg-surface-container border border-glass-border shadow-neumorphism text-text-muted",
      { hidden: countsByFilter.all > 0 },
    ]}>
    아직 등록된 이슈가 없습니다
  </div>

  <div
    id="issue-list"
    class="grid grid-cols-1 expanded:grid-cols-2 large:grid-cols-3 gap-4 medium:gap-6">
    {displayedIssues.map((post) => (
      <a
        href={`/${post.collectionType}?file=${post.id}`}
        data-issue-filters={post.filters.join(" ")}
        class:list={[
          "issue-card group relative flex flex-col justify-between p-5 medium:p-6 rounded-3xl bg-surface-container border border-glass-border shadow-neumorphism hover:shadow-neumorphism-hover transition-all duration-300 hover:-translate-y-0.5 overflow-hidden",
          { hidden: !post.filters.includes("all") },
        ]}>
        <div class="space-y-3">
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <div class="flex items-center gap-2">
              <span
                class={`text-xs font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider font-mono ${
                  post.collectionType === "projects"
                    ? "bg-brand-muted text-brand border border-brand/20"
                    : "bg-accent/10 text-accent border border-accent/20"
                }`}>
                {post.collectionType === "projects" ? "프로젝트" : "기술"}
              </span>
              <span class="text-xs text-text-muted font-medium">{post.data.category}</span>
            </div>

            <time
              datetime={post.data.pubDate.toISOString()}
              class="text-xs font-mono text-text-muted whitespace-nowrap">
              {formatDate(post.data.pubDate)}
            </time>
          </div>

          <h3 class="text-lg medium:text-xl font-bold group-hover:text-brand transition-colors duration-200">
            {post.data.title}
          </h3>

          {post.data.description && (
            <p class="text-sm text-text-muted line-clamp-2 leading-relaxed">
              {post.data.description}
            </p>
          )}
        </div>

        {post.data.tags && post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 pt-4 mt-4 border-t border-glass-border">
            {post.data.tags.map((tag: string) => (
              <span class="text-xs px-2.5 py-0.5 rounded-md bg-brand-soft text-brand/85 border border-brand/10 font-medium">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </a>
    ))}
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".issue-tab");
  const cards = document.querySelectorAll<HTMLElement>(".issue-card");
  const emptyState = document.getElementById("issue-empty");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const filter = tab.dataset.issueFilter || "all";

      tabs.forEach((t) => {
        const isSelected = t === tab;
        t.setAttribute("aria-selected", String(isSelected));
        t.classList.toggle("text-brand", isSelected);
        t.classList.toggle("font-bold", isSelected);
        t.classList.toggle("text-text-muted", !isSelected);
        t.classList.toggle("font-medium", !isSelected);
        t.querySelector(".tab-indicator")?.classList.toggle("hidden", !isSelected);
      });

      let visibleCount = 0;
      cards.forEach((card) => {
        const match = card.dataset.issueFilters?.split(" ").includes(filter) ?? false;
        card.classList.toggle("hidden", !match);
        if (match) visibleCount++;
      });
      emptyState?.classList.toggle("hidden", visibleCount > 0);
    });
  });
</script>
