---
import GitHubIcon from "@components/icons/GitHubIcon.astro";

interface Props {
  url: string;
  handle: string;
}

const { url, handle } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative overflow-hidden p-6 medium:p-8 rounded-3xl bg-surface-container border border-glass-border shadow-neumorphism hover:shadow-neumorphism-hover transition-all duration-300 hover:-translate-y-1 flex flex-col medium:flex-row expanded:flex-col items-start medium:items-center expanded:items-start justify-between gap-6">
  <div class="flex items-center gap-4">
    <div class="w-14 h-14 rounded-2xl bg-brand-muted flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
      <GitHubIcon class="h-7 w-7 text-brand" />
    </div>
    <div class="min-w-0">
      <h2 class="text-xl medium:text-2xl font-bold">GitHub</h2>
      <p class="text-sm medium:text-base text-text-muted break-all">{handle}</p>
    </div>
  </div>
</a>
