---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Contact",
  description = "이메일 또는 GitHub를 통해 언제든 연락하실 수 있습니다.",
} = Astro.props;
---

<header class="p-6 medium:p-8 rounded-3xl bg-surface-container border border-glass-border shadow-neumorphism">
  <h1 class="text-3xl medium:text-4xl expanded:text-5xl font-extrabold tracking-tight">{title}</h1>
  <p class="text-sm medium:text-base text-text-muted mt-2">{description}</p>
</header>
