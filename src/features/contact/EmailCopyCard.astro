---
interface Props {
  email: string;
}

const { email } = Astro.props;
---

<!-- Email Card: mailto 링크 대신 주소 옆 복사 아이콘 버튼 제공 -->
<div class="relative overflow-hidden p-6 medium:p-8 rounded-3xl bg-surface-container border border-glass-border shadow-neumorphism flex items-center">
  <div class="flex items-center gap-4 min-w-0">
    <div class="w-14 h-14 rounded-2xl bg-brand-muted flex items-center justify-center shrink-0">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-7 w-7 text-brand"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
      </svg>
    </div>
    <div class="min-w-0">
      <h2 class="text-xl medium:text-2xl font-bold">이메일</h2>
      <div class="flex items-center">
        <p id="email-address" class="text-sm medium:text-base text-text-muted break-all">
          {email}
        </p>
        <!-- 아이콘은 작게 표시하고 터치 영역은 48px 확보, 음수 마진으로 줄 높이 유지 -->
        <button
          type="button"
          data-copy-email={email}
          aria-label="이메일 주소 복사"
          title="이메일 주소 복사"
          class="shrink-0 -my-3.5 min-h-12 min-w-12 inline-flex items-center justify-center rounded-full text-text-muted hover:text-brand hover:bg-glass-bg-hover transition-colors cursor-pointer">
          <svg
            data-copy-icon
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
          </svg>
          <svg
            data-check-icon
            xmlns="http://www.w3.org/2000/svg"
            class="hidden h-4 w-4 text-brand"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <span id="copy-status" class="sr-only" aria-live="polite"></span>
</div>

<script>
  const RESET_DELAY_MS = 2000;

  const button = document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const copyIcon = button?.querySelector("[data-copy-icon]");
  const checkIcon = button?.querySelector("[data-check-icon]");
  const status = document.getElementById("copy-status");
  let resetTimer: number | undefined;

  function showResult(message: string, copied: boolean) {
    copyIcon?.classList.toggle("hidden", copied);
    checkIcon?.classList.toggle("hidden", !copied);
    if (status) status.textContent = message;
    window.clearTimeout(resetTimer);
    resetTimer = window.setTimeout(() => {
      copyIcon?.classList.remove("hidden");
      checkIcon?.classList.add("hidden");
      if (status) status.textContent = "";
    }, RESET_DELAY_MS);
  }

  button?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.copyEmail ?? "");
      showResult("이메일 주소가 복사되었습니다", true);
    } catch {
      // 클립보드 접근 불가 시 주소 텍스트를 선택해 수동 복사 유도
      const address = document.getElementById("email-address");
      if (address) window.getSelection()?.selectAllChildren(address);
      showResult("이메일 주소를 직접 복사해 주세요", false);
    }
  });
</script>

