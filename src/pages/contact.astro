---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactHeader from "../features/contact/ContactHeader.astro";
import EmailCopyCard from "../features/contact/EmailCopyCard.astro";
import GitHubProfileCard from "../features/contact/GitHubProfileCard.astro";

const EMAIL = "hyuntak61@gmail.com";
const GITHUB_URL = "https://github.com/Hyun-Tak-Lee";
const GITHUB_HANDLE = "@Hyun-Tak-Lee";
---

<BaseLayout title="Contact | Hyun-Tak Lee">
  <div class="flex-1 flex flex-col justify-center space-y-8">
    <ContactHeader />

    <div class="grid grid-cols-1 expanded:grid-cols-2 gap-6">
      <EmailCopyCard email={EMAIL} />
      <GitHubProfileCard url={GITHUB_URL} handle={GITHUB_HANDLE} />
    </div>
  </div>
</BaseLayout>
