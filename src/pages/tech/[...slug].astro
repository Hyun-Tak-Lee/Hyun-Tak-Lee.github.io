---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const techPosts = await getCollection("tech");
  return techPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout 
  title={`${post.data.title} | Hyun-Tak Lee`} 
  description={post.data.description} 
  image={post.data.image?.url} 
  type="article"
>
  <div class="grid grid-cols-1 expanded:grid-cols-12 gap-6 expanded:gap-8 items-start">
    <!-- Main Article Pane (Single Pane on Compact/Medium, 8-col Pane on Expanded) -->
    <div class="expanded:col-span-8 p-5 medium:p-8 rounded-3xl bg-surface-container border border-glass-border shadow-neumorphism">
      <header class="mb-8 pb-6 border-b border-glass-border">
        <div class="text-xs font-mono tracking-widest text-brand mb-3 flex flex-wrap items-center gap-2 uppercase">
          <span>TECH / {post.data.category}</span>
          {post.data.sub_category?.map((sub) => (
            <span class="flex items-center gap-2 text-text-muted">
              <span>•</span>
              <span>{sub}</span>
            </span>
          ))}
        </div>
        <h1 class="text-2xl medium:text-4xl expanded:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
          {post.data.title}
        </h1>
        {post.data.description && (
          <p class="text-base medium:text-lg text-text-muted mb-5 leading-relaxed">
            {post.data.description}
          </p>
        )}
        <div class="flex flex-wrap items-center text-xs medium:text-sm text-text-muted font-mono gap-x-4 gap-y-2">
          <time datetime={post.data.pubDate.toISOString()}>
            {new Date(post.data.pubDate).toLocaleDateString('ko-KR')}
          </time>
          <span>•</span>
          <span>By {post.data.author}</span>
        </div>
      </header>

      <!-- Mobile / Tablet Collapsible TOC (Hidden on Expanded PC where sticky sidebar is shown) -->
      {tocHeadings.length > 0 && (
        <details class="expanded:hidden mb-8 p-4 rounded-2xl bg-glass-bg border border-glass-border">
          <summary class="text-sm font-bold text-brand cursor-pointer select-none">
            목차 (On this page)
          </summary>
          <ul class="mt-3 space-y-2 text-sm border-t border-glass-border pt-3">
            {tocHeadings.map((heading) => (
              <li class={heading.depth === 3 ? "pl-4" : ""}>
                <a
                  href={`#${heading.slug}`}
                  class="block py-1 text-text-muted hover:text-brand transition-colors"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}

      <article class="prose prose-base medium:prose-lg max-w-none prose-headings:font-bold prose-headings:scroll-mt-28 md:prose-headings:scroll-mt-20 prose-a:text-brand hover:prose-a:underline prose-img:rounded-2xl medium:prose-img:rounded-3xl prose-pre:overflow-x-auto">
        <Content />
      </article>

      <div class="mt-12 pt-6 border-t border-glass-border flex flex-col medium:flex-row justify-between items-start medium:items-center gap-4">
        <a href="/tech" class="min-h-12 inline-flex items-center text-sm medium:text-base font-bold text-brand hover:underline">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Knowledge Base
        </a>
        
        <div class="flex flex-wrap gap-2 expanded:hidden">
          {post.data.tags?.map(tag => (
            <span class="px-3 py-1 rounded-full bg-brand-muted text-xs font-medium text-brand">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Supporting Pane (PC Expanded Only: Sticky Table of Contents & Metadata) -->
    <aside aria-label="Document Outline and Metadata" class="hidden expanded:flex expanded:col-span-4 flex-col gap-6 sticky top-8">
      {tocHeadings.length > 0 && (
        <div class="p-6 rounded-3xl bg-surface-container border border-glass-border shadow-neumorphism">
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-brand mb-4">
            On This Page
          </h2>
          <ul class="space-y-2.5 text-sm">
            {tocHeadings.map((heading) => (
              <li class={heading.depth === 3 ? "pl-3 border-l border-glass-border" : ""}>
                <a
                  href={`#${heading.slug}`}
                  class="block py-1 text-text-muted hover:text-brand transition-colors leading-snug"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="p-6 rounded-3xl bg-surface-container border border-glass-border shadow-neumorphism">
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-brand mb-4">
            Tags
          </h2>
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="px-3 py-1 rounded-full bg-brand-muted text-xs font-medium text-brand">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )}
    </aside>
  </div>
</BaseLayout>
