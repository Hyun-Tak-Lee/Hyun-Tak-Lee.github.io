---
import { render } from "astro:content";
import RepoDetailLayout from "../../features/repo/RepoDetailLayout.astro";
import { getSortedTechPosts } from "../../features/tech/queries";

export async function getStaticPaths() {
  const techPosts = await getSortedTechPosts();
  return techPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<RepoDetailLayout
  collectionName="tech"
  collectionLabel="기술"
  backLabel="기술 문서 저장소로 돌아가기"
  itemId={post.id}
  data={post.data}
  headings={headings}
  Content={Content}
/>
