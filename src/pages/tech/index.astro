---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RepoWorkspace, { type WorkspaceItem } from "../../components/repo/RepoWorkspace.astro";

const techPosts = await getCollection("tech");
const sortedTech = techPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const items: WorkspaceItem[] = await Promise.all(
  sortedTech.map(async (post) => {
    const { Content, headings } = await render(post);
    return {
      id: post.id,
      title: post.data.title,
      category: post.data.category,
      sub_category: post.data.sub_category,
      pubDate: post.data.pubDate,
      description: post.data.description,
      tags: post.data.tags,
      headings,
      Content,
    };
  }),
);
---

<BaseLayout
  title="기술 문서 저장소 | Hyun-Tak Lee"
  description="사용한 기술 스펙과 아키텍처 의사결정 기록을 탐색할 수 있는 공간입니다.">
  <RepoWorkspace
    collectionName="tech"
    title="기술 문서 저장소"
    description="사용한 기술 스펙과 아키텍처 의사결정 기록을 탐색할 수 있습니다."
    badge="엔지니어링 노트"
    items={items}
  />
</BaseLayout>
