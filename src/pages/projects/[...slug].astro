---
import { render } from "astro:content";
import RepoDetailLayout from "../../features/repo/RepoDetailLayout.astro";
import { getEnrichedProjects } from "../../features/projects/queries";

export async function getStaticPaths() {
  const enrichedProjects = await getEnrichedProjects();
  return enrichedProjects.map(({ entry, architecture }) => ({
    params: { slug: entry.id },
    props: { project: entry, architecture },
  }));
}

const { project, architecture } = Astro.props;
const { Content, headings } = await render(project);
---

<RepoDetailLayout
  collectionName="projects"
  collectionLabel="프로젝트"
  backLabel="프로젝트 저장소로 돌아가기"
  itemId={project.id}
  data={project.data}
  architecture={architecture}
  headings={headings}
  Content={Content}
/>
