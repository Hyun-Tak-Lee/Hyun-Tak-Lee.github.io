---
import { render } from "astro:content";
import ProjectDetailLayout from "@features/projects/detail/ProjectDetailLayout.astro";
import { getEnrichedProjects } from "@features/projects/queries";

export async function getStaticPaths() {
  const enrichedProjects = await getEnrichedProjects();
  return enrichedProjects.map(({ entry, architecture }) => ({
    params: { slug: entry.id },
    props: { project: entry, architecture },
  }));
}

const { project, architecture } = Astro.props;
const { Content, headings } = await render(project);
---

<ProjectDetailLayout
  backLabel="프로젝트 쇼케이스로 돌아가기"
  itemId={project.id}
  data={project.data}
  architecture={architecture}
  headings={headings}
  Content={Content}
/>
