---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArrowLeftIcon from "../../components/icons/ArrowLeftIcon.astro";
import { formatDate } from "../../utils/date";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout 
  title={`${project.data.title} | Hyun-Tak Lee`} 
  description={project.data.description} 
  image={project.data.image?.url} 
  type="article"
>
  <div class="grid grid-cols-1 expanded:grid-cols-12 gap-6 expanded:gap-8 items-start">
    <!-- Main Project Pane -->
    <div class="expanded:col-span-8 p-5 medium:p-8 rounded-3xl bg-surface-container border border-glass-border shadow-neumorphism">
      <header class="mb-8 pb-6 border-b border-glass-border">
        <div class="text-xs font-mono tracking-widest text-brand mb-3 flex flex-wrap items-center gap-2 uppercase">
          <span>프로젝트 / {project.data.category}</span>
          {project.data.sub_category?.map(sub => (
            <span class="flex items-center gap-2 text-text-muted">
              <span>•</span>
              <span>{sub}</span>
            </span>
          ))}
        </div>
        <h1 class="text-2xl medium:text-4xl expanded:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
          {project.data.title}
        </h1>
        <div class="flex flex-wrap items-center text-xs medium:text-sm text-text-muted font-mono gap-x-4 gap-y-2">
          <time datetime={project.data.pubDate.toISOString()}>
            {formatDate(project.data.pubDate)}
          </time>
          <span>•</span>
          <span>작성자 {project.data.author}</span>
        </div>
      </header>

      {project.data.image && (
        <div class="mb-8 rounded-2xl medium:rounded-3xl overflow-hidden shadow-neumorphism">
          <img 
            src={project.data.image.url} 
            alt={project.data.image.alt} 
            class="w-full h-auto object-cover"
          />
        </div>
      )}

      {tocHeadings.length > 0 && (
        <details class="expanded:hidden mb-8 px-4 rounded-2xl bg-glass-bg border border-glass-border">
          <summary class="py-3.5 text-sm font-bold text-brand cursor-pointer select-none">
            목차
          </summary>
          <ul class="pt-2 pb-3 text-sm border-t border-glass-border">
            {tocHeadings.map((heading) => (
              <li class={heading.depth === 3 ? "pl-4" : ""}>
                <a
                  href={`#${heading.slug}`}
                  class="min-h-12 flex items-center text-text-muted hover:text-brand transition-colors"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}

      <article class="prose prose-brand prose-base medium:prose-lg max-w-none prose-headings:font-bold prose-headings:scroll-mt-[calc(var(--spacing-header)+1rem)] prose-a:text-brand hover:prose-a:underline prose-img:rounded-2xl medium:prose-img:rounded-3xl prose-pre:overflow-x-auto">
        <Content />
      </article>

      <div class="mt-12 pt-6 border-t border-glass-border flex flex-col medium:flex-row justify-between items-start medium:items-center gap-4">
        <a href="/projects" class="min-h-12 inline-flex items-center text-sm medium:text-base font-bold text-brand hover:underline">
          <ArrowLeftIcon class="h-5 w-5 mr-2 shrink-0" />
          프로젝트 목록으로
        </a>
        
        <div class="flex flex-wrap gap-2 expanded:hidden">
          {project.data.tags?.map(tag => (
            <span class="px-3 py-1 rounded-full bg-brand-muted text-xs font-medium text-brand">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Supporting Pane (PC Expanded Only) -->
    <aside aria-label="프로젝트 목차 및 정보" class="hidden expanded:flex expanded:col-span-4 flex-col gap-6 sticky top-[calc(var(--spacing-header)+2rem)]">
      {tocHeadings.length > 0 && (
        <div class="p-6 rounded-3xl bg-surface-container border border-glass-border shadow-neumorphism">
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-brand mb-4">
            목차
          </h2>
          <ul class="text-sm">
            {tocHeadings.map((heading) => (
              <li class={heading.depth === 3 ? "pl-3 border-l border-glass-border" : ""}>
                <a
                  href={`#${heading.slug}`}
                  class="min-h-12 flex items-center text-text-muted hover:text-brand transition-colors leading-snug"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {project.data.tags && project.data.tags.length > 0 && (
        <div class="p-6 rounded-3xl bg-surface-container border border-glass-border shadow-neumorphism">
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-brand mb-4">
            기술 스택 및 태그
          </h2>
          <div class="flex flex-wrap gap-2">
            {project.data.tags.map((tag) => (
              <span class="px-3 py-1 rounded-full bg-brand-muted text-xs font-medium text-brand">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )}
    </aside>
  </div>
</BaseLayout>
