---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = await getCollection("projects");
const techPosts = await getCollection("tech");

const allIssues = [
  ...projects.map(post => ({ ...post, collectionType: "projects" as const })),
  ...techPosts.map(post => ({ ...post, collectionType: "tech" as const }))
];

const sortedIssues = allIssues.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const recentIssues = sortedIssues.slice(0, 5);
---

<BaseLayout title="Home | Hyun-Tak Lee">
  <div class="max-w-5xl mx-auto px-6 py-12 md:py-20">
    <!-- Hero Section -->
    <section class="text-center mb-20 md:mb-24">
      <h1 class="text-5xl md:text-7xl font-black tracking-tighter mb-6 leading-[1.1]">
        <span class="text-transparent bg-clip-text bg-linear-to-r from-brand via-brand-hover to-brand py-2">
          Knowledge Base
        </span>
      </h1>
      <p class="text-lg md:text-xl text-text-muted max-w-2xl mx-auto leading-relaxed">
        안녕하세요, 이현탁입니다. 제가 수행한 <span class="text-brand font-bold">프로젝트</span>들과
        그 과정에서 얻은 <span class="text-brand font-bold">기술적 통찰</span>을 정리해둔 지식 저장고입니다.
      </p>
    </section>

    <!-- Recent Issues Section -->
    <section class="mb-24">
      <div class="flex items-center justify-between mb-8 border-b border-glass-border pb-4">
        <h2 class="text-2xl md:text-3xl font-bold flex items-center gap-3">
          <span class="w-2.5 h-8 bg-brand rounded-full"></span>
          최근 이슈
        </h2>
        <span class="text-sm font-mono text-text-muted tracking-wider">Recent Issues</span>
      </div>
      
      <div class="space-y-6">
        {recentIssues.length === 0 ? (
          <div class="text-center py-16 rounded-3xl bg-glass-bg border border-glass-border shadow-neumorphism text-text-muted">
            아직 등록된 이슈가 없습니다.
          </div>
        ) : (
          recentIssues.map((post) => (
            <a
              href={`/${post.collectionType}/${post.id}`}
              class="group relative block p-6 md:p-8 rounded-[2rem] bg-glass-bg border border-glass-border shadow-neumorphism hover:shadow-neumorphism-hover transition-all duration-300 hover:-translate-y-1 overflow-hidden"
            >
              <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="space-y-3 flex-1">
                  <div class="flex items-center gap-3 flex-wrap">
                    <span class={`text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider font-mono ${
                      post.collectionType === "projects"
                        ? "bg-brand-muted text-brand border border-brand/20"
                        : "bg-emerald-500/10 text-emerald-500 border border-emerald-500/20"
                    }`}>
                      {post.collectionType === "projects" ? "Project" : "Tech"}
                    </span>
                    <span class="text-xs text-text-muted font-medium">
                      {post.data.category}
                    </span>
                  </div>
                  
                  <h3 class="text-xl md:text-2xl font-bold group-hover:text-brand transition-colors duration-200">
                    {post.data.title}
                  </h3>
                  
                  {post.data.description && (
                    <p class="text-sm md:text-base text-text-muted line-clamp-2 leading-relaxed">
                      {post.data.description}
                    </p>
                  )}
                  
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 pt-1">
                      {post.data.tags.map((tag: string) => (
                        <span class="text-[11px] px-2 py-0.5 rounded-md bg-brand-soft text-brand/80 border border-brand/10 font-medium">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
                
                <div class="text-xs md:text-sm font-mono text-text-muted whitespace-nowrap self-start md:self-center mt-2 md:mt-0">
                  {new Date(post.data.pubDate).toLocaleDateString("ko-KR", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </div>
              </div>
              <div class="absolute top-0 right-0 -mr-16 -mt-16 w-32 h-32 bg-brand-soft rounded-full blur-2xl group-hover:bg-brand-muted transition-colors duration-500"></div>
            </a>
          ))
        )}
      </div>
    </section>



    <!-- Footer -->
    <footer class="mt-20 text-center text-text-muted text-xs font-mono tracking-widest">
      © 2026 HYUN-TAK LEE. BUILT WITH ASTRO.
    </footer>
  </div>
</BaseLayout>
