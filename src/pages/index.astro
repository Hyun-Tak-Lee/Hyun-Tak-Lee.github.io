---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../features/home/HomeHero.astro";
import RecentIssues from "../features/home/RecentIssues.astro";
import { getHomeDashboardData } from "../features/home/issues";

const RECENT_LIMIT = 5;
const PROFILE_IMAGE_URL = "https://avatars.githubusercontent.com/u/58458197?s=192&v=4";

const { projectCount, techCount, countsByFilter, displayedIssues } =
  await getHomeDashboardData(RECENT_LIMIT);
---

<BaseLayout
  title="홈 | Hyun-Tak Lee"
  description="개인 기술 블로그 및 프로젝트 포트폴리오 사이트입니다. 소프트웨어 엔지니어링 기술 스택과 작업물들을 공유합니다.">
  <div class="flex-1 flex flex-col justify-between gap-10 expanded:gap-14">
    <HomeHero
      profileImageUrl={PROFILE_IMAGE_URL}
      projectCount={projectCount}
      techCount={techCount}
    />

    <RecentIssues countsByFilter={countsByFilter} displayedIssues={displayedIssues} />
  </div>
</BaseLayout>
