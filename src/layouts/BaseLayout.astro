---
import "../global.css";
import Header from "./HeaderLayout.astro";
import BaseHead from "../components/BaseHead.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
}

const { title, description, image, type } = Astro.props;
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} image={image} type={type} />
  </head>
  <body class="min-h-screen bg-linear-to-r from-base-bg-start via-base-bg-mid to-base-bg-end">
    <Header />
    <main class="pt-24 pb-20 min-h-[calc(100vh-80px)] px-8 md:px-12 lg:px-24">
      <slot />
    </main>
  </body>
</html>
