---
import "../styles/global.css";
import Header from "../components/Header.astro";
import BaseHead from "../components/BaseHead.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
}

const { title, description, image, type } = Astro.props;
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} image={image} type={type} />
  </head>
  <body class="min-h-dvh bg-linear-to-r from-base-bg-start via-base-bg-mid to-base-bg-end">
    <Header currentPath={Astro.url.pathname} />
    <main class="pt-[6.5rem] md:pt-16 min-h-dvh flex flex-col">
      <div class="w-full max-w-6xl mx-auto px-4 md:px-8 py-6 md:py-10 flex-1 flex flex-col">
        <slot />
      </div>
    </main>
  </body>
</html>
