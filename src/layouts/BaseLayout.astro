---
import "../global.css";
import Header from "./HeaderLayout.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-linear-to-r from-base-bg-start via-base-bg-mid to-base-bg-end">
    <Header />
    <main class="pt-24 pb-20 min-h-[calc(100vh-80px)] px-8 md:px-12 lg:px-24">
      <slot />
    </main>
  </body>
</html>
