---
import FolderIcon from "../icons/FolderIcon.astro";
import FileCodeIcon from "../icons/FileCodeIcon.astro";
import SearchIcon from "../icons/SearchIcon.astro";

export interface RepoTreeItem {
  id: string;
  title: string;
  category: string;
  sub_category?: string[];
  tags?: string[];
}

interface Props {
  items: RepoTreeItem[];
  activeId: string;
  collectionName: string;
}

const { items, activeId, collectionName } = Astro.props;

// 카테고리별 그룹화
const grouped = items.reduce<Record<string, RepoTreeItem[]>>((acc, item) => {
  if (!acc[item.category]) acc[item.category] = [];
  acc[item.category].push(item);
  return acc;
}, {});

const categories = Object.keys(grouped).sort();
---

<aside
  aria-label="저장소 파일 탐색기"
  class="h-full flex flex-col rounded-3xl bg-surface-container border border-glass-border shadow-neumorphism overflow-hidden select-none">
  <!-- 탐색기 헤더 및 검색창 -->
  <div class="p-4 border-b border-glass-border space-y-3 shrink-0">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-brand">
          저장소 탐색기
        </span>
        <span
          class="text-xs font-mono px-2 py-0.5 rounded-full bg-brand-muted text-brand font-semibold">
          {items.length}
        </span>
      </div>
      <span class="text-[11px] font-mono text-text-muted">/{collectionName}</span>
    </div>

    <!-- 실시간 필터 검색 인풋 -->
    <div class="relative">
      <SearchIcon
        class="w-4 h-4 text-text-muted absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"
      />
      <input
        type="search"
        data-repo-search
        placeholder="문서명, 분류, 태그 검색..."
        aria-label="저장소 파일 실시간 검색"
        class="w-full min-h-12 pl-10 pr-4 rounded-2xl bg-glass-bg border border-glass-border text-xs medium:text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-all"
      />
    </div>
  </div>

  <!-- 계층 트리 목록 -->
  <div class="flex-1 overflow-y-auto p-3 space-y-3">
    {
      categories.map((category) => {
        const catItems = grouped[category];
        return (
          <details open data-tree-folder class="group/folder mb-2">
            <summary class="min-h-12 flex items-center justify-between px-3 py-2 rounded-2xl hover:bg-glass-bg cursor-pointer text-xs font-bold text-text-muted hover:text-text-primary uppercase tracking-wider transition-colors list-none">
              <div class="flex items-center gap-2 min-w-0">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-3.5 h-3.5 text-text-muted group-open/folder:rotate-90 transition-transform shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                  aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                <FolderIcon class="w-4 h-4 text-brand shrink-0" />
                <span class="truncate">{category}</span>
              </div>
              <span data-folder-count class="text-[11px] font-mono text-text-muted font-normal ml-2">
                {catItems.length}
              </span>
            </summary>

            <ul class="pl-4 mt-1 border-l border-glass-border space-y-1">
              {catItems.map((item) => {
                const searchCorpus = [
                  item.title,
                  item.category,
                  ...(item.sub_category ?? []),
                  ...(item.tags ?? []),
                ]
                  .join(" ")
                  .toLowerCase();
                return (
                  <li data-tree-item data-search-text={searchCorpus}>
                    <button
                      type="button"
                      data-repo-file-btn={item.id}
                      aria-current={item.id === activeId ? "true" : "false"}
                      class="w-full min-h-12 px-3 py-2 rounded-2xl flex items-center justify-between text-left transition-all duration-150 cursor-pointer text-xs medium:text-sm border border-transparent text-text-muted aria-[current=false]:hover:text-text-primary aria-[current=false]:hover:bg-glass-bg aria-[current=true]:bg-brand-soft aria-[current=true]:text-brand aria-[current=true]:font-bold aria-[current=true]:border-brand/35 aria-[current=true]:shadow-xs">
                      <div class="flex items-center gap-2 min-w-0">
                        <FileCodeIcon class="w-4 h-4 shrink-0" />
                        <span class="truncate">{item.title}</span>
                      </div>
                      <span class="text-[10px] font-mono text-text-muted ml-2 shrink-0">.md</span>
                    </button>
                  </li>
                );
              })}
            </ul>
          </details>
        );
      })
    }
    <p data-tree-empty class="hidden p-6 text-center text-xs text-text-muted">
      검색 결과가 없습니다.
    </p>
  </div>
</aside>
