---
import { formatDate } from "../../utils/date";

export interface RepoInspectorItem {
  id: string;
  category: string;
  sub_category?: string[];
  pubDate: Date;
  author: string;
  tags?: string[];
  headings: Array<{ depth: number; slug: string; text: string }>;
}

interface Props {
  items: RepoInspectorItem[];
  activeId: string;
  collectionName: string;
}

const { items, activeId, collectionName } = Astro.props;

// Astro 템플릿(JSX) 내 '<' 기호가 JSX 태그로 오인되는 파서 오류 방지를 위해 프론트매터에서 TOC 목차 사전 처리
const processedItems = items.map((item) => ({
  ...item,
  toc: (item.headings ?? []).filter((h) => h.depth >= 2 && h.depth <= 3),
}));
---

<aside 
  aria-label="문서 메타데이터 및 목차"
  class="h-full flex flex-col rounded-3xl bg-surface-container border border-glass-border shadow-neumorphism overflow-hidden"
>
  <div class="p-4 border-b border-glass-border shrink-0">
    <span class="text-xs font-mono font-bold uppercase tracking-wider text-brand">인스펙터 (속성)</span>
  </div>

  <div class="flex-1 overflow-y-auto p-4 space-y-6">
    {processedItems.map((item) => {
      const isActive = item.id === activeId;

      return (
        <div 
          data-inspector-panel={item.id} 
          class:list={["space-y-6", !isActive && "hidden"]}
        >
          <!-- 파일 사양 및 메타데이터 -->
          <section class="space-y-3">
            <h3 class="text-xs font-mono uppercase tracking-wider text-text-muted font-bold">
              파일 사양
            </h3>
            <div class="rounded-2xl bg-glass-bg border border-glass-border p-3.5 space-y-2.5 text-xs">
              <div class="flex justify-between items-center text-text-muted">
                <span>분류</span>
                <span class="font-medium text-text-primary">{item.category}</span>
              </div>
              {item.sub_category && item.sub_category.length > 0 && (
                <div class="flex justify-between items-center text-text-muted">
                  <span>세부 분류</span>
                  <span class="font-medium text-text-primary">{item.sub_category.join(", ")}</span>
                </div>
              )}
              <div class="flex justify-between items-center text-text-muted">
                <span>작성자</span>
                <span class="font-medium text-text-primary">{item.author}</span>
              </div>
              <div class="flex justify-between items-center text-text-muted">
                <span>발행일</span>
                <time datetime={item.pubDate.toISOString()} class="font-mono text-text-primary">
                  {formatDate(item.pubDate)}
                </time>
              </div>
              <div class="pt-2 border-t border-glass-border flex justify-between items-center text-text-muted">
                <span>가상 경로</span>
                <span class="font-mono text-xs text-brand truncate max-w-[140px]" title={`/${collectionName}/${item.id}.md`}>
                  /{collectionName}/{item.id}.md
                </span>
              </div>
            </div>
          </section>

          <!-- 기술 태그 목록 -->
          {item.tags && item.tags.length > 0 && (
            <section class="space-y-3">
              <h3 class="text-xs font-mono uppercase tracking-wider text-text-muted font-bold">
                기술 태그
              </h3>
              <div class="flex flex-wrap gap-1.5">
                {item.tags.map((tag) => (
                  <span class="px-2.5 py-1 rounded-xl bg-glass-bg border border-glass-border text-xs text-text-primary font-mono">
                    #{tag}
                  </span>
                ))}
              </div>
            </section>
          )}

          <!-- 자동 추출 목차 (TOC) -->
          {item.toc.length > 0 && (
            <section class="space-y-3">
              <h3 class="text-xs font-mono uppercase tracking-wider text-text-muted font-bold">
                문서 목차 (TOC)
              </h3>
              <nav aria-label="문서 내부 목차" class="space-y-1">
                {item.toc.map((heading) => (
                  <a
                    href={`#${heading.slug}`}
                    class:list={[
                      "min-h-12 flex items-center px-2.5 py-1.5 rounded-xl text-xs text-text-muted hover:text-brand hover:bg-glass-bg transition-colors",
                      heading.depth === 3 && "pl-5",
                    ]}
                  >
                    <span class="truncate">{heading.text}</span>
                  </a>
                ))}
              </nav>
            </section>
          )}
        </div>
      );
    })}
  </div>
</aside>
