---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { name: "Home", href: "/" },
  { name: "Projects", href: "/projects" },
  { name: "Tech", href: "/tech" },
  { name: "Contact", href: "/contact" },
] as const;

function isActive(href: string, path: string): boolean {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<!-- Google Web Standard Top Header: 2-tier Fixed Tabs on Mobile, 1-tier Inline Bar on PC -->
<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-40 bg-surface-nav backdrop-blur-xl border-b border-glass-border"
>
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    <!-- Top Row: Brand Logo + Desktop Primary Tabs + GitHub Action -->
    <div class="h-14 md:h-16 flex items-center justify-between gap-4">
      <div class="flex items-center gap-8 min-w-0 h-full">
        <a
          href="/"
          class="min-h-12 inline-flex items-center gap-2.5 text-lg md:text-2xl font-extrabold tracking-tight hover:opacity-85 transition-opacity truncate"
        >
          <span class="w-8 h-8 rounded-xl bg-brand/15 border border-brand/25 flex items-center justify-center text-brand text-sm font-black shrink-0">
            HT
          </span>
          <span class="text-transparent bg-clip-text bg-linear-to-r from-brand to-brand-hover truncate">
            Hyun-Tak Lee
          </span>
        </a>

        <!-- PC Primary Navigation Tabs (Inline on ≥768px) -->
        <nav aria-label="Primary Navigation" class="hidden md:flex items-center h-full gap-1">
          {navItems.map((item) => {
            const active = isActive(item.href, currentPath);
            return (
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "relative h-full inline-flex items-center px-4 text-sm font-semibold tracking-tight transition-colors",
                  active
                    ? "text-brand font-bold"
                    : "text-text-muted hover:text-text-primary hover:bg-glass-bg-hover/50",
                ]}
              >
                {item.name}
                {active && (
                  <span
                    class="absolute bottom-0 left-3 right-3 h-[3px] rounded-t-full bg-brand"
                    aria-hidden="true"
                  />
                )}
              </a>
            );
          })}
        </nav>
      </div>

      <!-- Right Action: GitHub Profile -->
      <a
        href="https://github.com/Hyun-Tak-Lee"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub 프로필 열기"
        class="min-h-11 px-3 inline-flex items-center gap-2 rounded-full hover:bg-glass-bg-hover text-text-muted hover:text-brand transition-colors text-sm font-medium shrink-0"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>
    </div>

    <!-- Mobile Primary Navigation Tabs (2nd Row on <768px: 4 Equal-Width Fixed Tabs, No Hamburger) -->
    <nav
      aria-label="Mobile Primary Navigation"
      class="md:hidden grid grid-cols-4 border-t border-glass-border -mx-4 px-2"
    >
      {navItems.map((item) => {
        const active = isActive(item.href, currentPath);
        return (
          <a
            href={item.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "relative h-12 inline-flex items-center justify-center text-sm tracking-tight transition-colors",
              active
                ? "text-brand font-bold"
                : "text-text-muted hover:text-text-primary font-medium",
            ]}
          >
            {item.name}
            {active && (
              <span
                class="absolute bottom-0 left-3 right-3 h-[3px] rounded-t-full bg-brand"
                aria-hidden="true"
              />
            )}
          </a>
        );
      })}
    </nav>
  </div>
</header>
