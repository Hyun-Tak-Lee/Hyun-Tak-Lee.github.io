  xmlns="http://www.w3.org/2000/svg"
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  aria-hidden="true">
  <circle cx="12" cy="12" r="9" stroke-linecap="round" stroke-linejoin="round"></circle>
  <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v-4"></path>
  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8h.01"></path>
</svg>
